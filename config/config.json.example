{
  "corpus_path": "../meta/corpus",
  "corpus_timeout_ms": 5000,
  "http": {
    "host": "127.0.0.1",
    "port": 2699,
    "credentials_file": "credentials.json",
    "allowed_peers": ["127.0.0.1"],
    "allowed_hosts": ["corpus.example.com"],
    "allowed_origins": ["https://corpus.example.com"],
    "global_concurrency": 2,
    "client_concurrency": 1,
    "body_timeout_ms": 5000
  },
  "mcp": {
    "transport": "http",
    "ledger": {
      "path": "../var/execution-ledger.sqlite3",
      "busy_timeout_ms": 1000,
      "max_tasks": 10000,
      "max_mb": 256
    },
    "task_limits": {
      "search_calls": 16,
      "read_calls": 32,
      "estimated_evidence_tokens": 64000
    },
    "stdio": {
      "frame_timeout_ms": 5000,
      "write_timeout_ms": 5000
    }
  }
}
